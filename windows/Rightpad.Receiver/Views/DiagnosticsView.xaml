<UserControl x:Class="Rightpad.Receiver.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel><TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Input / Transport" Style="{StaticResource SectionTitle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Touch Samples" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="Accepted samples per second received by Windows."/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Stats.SamplesHz, StringFormat={}{0} Hz}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="SamplesHz"/><TextBlock Grid.Row="1" Text="UDP Packets" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="All received datagrams, including rejected and duplicate packets."/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stats.PacketsHz, StringFormat={}{0} Hz}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="PacketsHz"/><TextBlock Grid.Row="2" Text="Gap" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="Cumulative sequence gap estimate."/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Stats.Gap}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Gap"/><TextBlock Grid.Row="3" Text="Old" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Stats.Old}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Old"/><TextBlock Grid.Row="4" Text="Invalid" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Stats.Invalid}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Invalid"/><TextBlock Grid.Row="5" Text="Duplicate" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Stats.Duplicate}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Duplicate"/><TextBlock Grid.Row="6" Text="Input Timeout" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="2-second diagnostic only; silence does not prove disconnection."/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Stats.Timeouts}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Timeouts"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions><TextBlock Text="Heartbeat Packets" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Stats.Heartbeats}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Heartbeats"/><TextBlock Grid.Row="1" Text="Presence Timeouts" Style="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stats.PresenceTimeouts}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="PresenceTimeouts"/><TextBlock Grid.Row="2" Text="Outdated Run Packets" Style="{StaticResource Muted}" FontSize="13"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Stats.OutdatedRuns}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="OutdatedRuns"/></Grid>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Receiver" Style="{StaticResource SectionTitle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Runtime State" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Stats.RuntimeState}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="RuntimeState"/><TextBlock Grid.Row="1" Text="Mouse Backend" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stats.MouseBackend}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="MouseBackend"/><TextBlock Grid.Row="2" Text="Touch Session" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Stats.Session}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Session"/><TextBlock Grid.Row="3" Text="Last Accepted" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Stats.LastAccepted}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="LastAccepted"/><TextBlock Grid.Row="4" Text="Last Remote IP" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Stats.RemoteIp}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="RemoteIp"/></Grid>
      </StackPanel></Border>
    </Grid>
  </StackPanel>
</UserControl>
