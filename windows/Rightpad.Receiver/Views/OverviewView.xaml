<UserControl x:Class="Rightpad.Receiver.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel><TextBlock Text="Overview" Style="{StaticResource PageTitle}"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connection" Style="{StaticResource SectionTitle}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Status" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Stats.Status}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Status"/><TextBlock Grid.Row="1" Text="Android IP" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stats.RemoteIp}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="RemoteIp"/><TextBlock Grid.Row="3" Text="Receiver UDP" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="Listening address, not the Android destination address."/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Stats.Endpoint}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Endpoint"/><TextBlock Grid.Row="2" Text="Last Seen" Style="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Stats.LastSeen}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="LastSeen"/></Grid></StackPanel>
        <StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Touch Samples" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Stats.SamplesHz, StringFormat={}{0} Hz}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="SamplesHz"/><TextBlock Grid.Row="1" Text="UDP Packets" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stats.PacketsHz, StringFormat={}{0} Hz}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="PacketsHz"/><TextBlock Grid.Row="2" Text="Gap" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="Cumulative forward sequence gap estimate, not final loss."/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Stats.Gap}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Gap"/><TextBlock Grid.Row="3" Text="Old" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Stats.Old}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Old"/><TextBlock Grid.Row="4" Text="Invalid" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Stats.Invalid}" Style="{StaticResource DataValue}" AutomationProperties.AutomationId="Invalid"/></Grid></StackPanel>
      </Grid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel MaxWidth="440" HorizontalAlignment="Left">
      <TextBlock Text="Receiver" Style="{StaticResource SectionTitle}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Receiver" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Stats.RuntimeState}"/>
        <Button Grid.Row="1" Grid.Column="1" Content="{Binding ActionText}" IsEnabled="{Binding CanToggle}" Click="ToggleReceiver" MinWidth="154" Margin="0,9,0,0" AutomationProperties.AutomationId="ToggleReceiver"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsStopped}" Value="True"><Setter Property="Background" Value="{StaticResource BlueBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </Grid>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
