<UserControl x:Class="Rightpad.Receiver.TapView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rightpad.Receiver">
  <StackPanel><TextBlock Text="Tap" Style="{StaticResource PageTitle}"/>
    <Border Style="{StaticResource Card}"><StackPanel MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Tap settings" Style="{StaticResource SectionTitle}"/>
      <local:NumericEditor DataContext="{Binding Settings.TapMaxDuration}"/>
      <local:NumericEditor DataContext="{Binding Settings.MovementThreshold}"/>
      <TextBlock Text="X and Y are checked separately from the DOWN position in Android touch pixels." Style="{StaticResource Muted}" FontSize="12" Margin="210,0,0,6" MaxWidth="470" HorizontalAlignment="Left"/>
      <local:NumericEditor DataContext="{Binding Settings.ClickHold}"/>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0"><TextBlock Text="Changes apply to new input actions." Style="{StaticResource Muted}" FontSize="13"/></Border>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
