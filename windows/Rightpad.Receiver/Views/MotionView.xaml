<UserControl x:Class="Rightpad.Receiver.MotionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rightpad.Receiver">
  <StackPanel><TextBlock Text="Motion" Style="{StaticResource PageTitle}"/>
    <Border Style="{StaticResource Card}"><StackPanel MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Motion settings" Style="{StaticResource SectionTitle}"/>
      <local:NumericEditor DataContext="{Binding Settings.SensitivityX}"/>
      <local:NumericEditor DataContext="{Binding Settings.SensitivityY}"/>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0"><TextBlock Text="Production motion: fixed 1000 Hz K24-r5 Earned-Settle · tau 24 ms · support 120 ms · Q0-C · 12 ms playout. Sensitivity is fixed for each Receiver run." TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="13"/></Border>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
