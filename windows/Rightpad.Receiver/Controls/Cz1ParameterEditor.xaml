<UserControl x:Class="Rightpad.Receiver.Cz1ParameterEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsEnabled="{Binding IsEnabled}">
  <Grid Margin="0,3" HorizontalAlignment="Left">
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13"/>
    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" PreviewKeyDown="InputKeyDown" LostKeyboardFocus="InputLostFocus"/>
    <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource Muted}" Margin="10,0,0,0" FontSize="13"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="#F0AA91" FontSize="12" TextWrapping="Wrap" Style="{StaticResource OptionalNotice}"/>
  </Grid>
</UserControl>
