<UserControl x:Class="Rightpad.Receiver.NumericEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,4" HorizontalAlignment="Left">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="112"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
    <TextBox x:Name="Input" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" PreviewKeyDown="InputKeyDown" LostKeyboardFocus="InputLostFocus"/>
    <Button Grid.Column="2" Content="−" Padding="0" Margin="4,0,0,0" FontSize="15" Click="Decrease" AutomationProperties.Name="Decrease"/>
    <Button Grid.Column="3" Content="+" Padding="0" Margin="4,0,0,0" FontSize="15" Click="Increase" AutomationProperties.Name="Increase"/>
    <TextBlock Grid.Column="4" Text="{Binding Unit}" Style="{StaticResource Muted}" Margin="8,0,0,0" FontSize="13"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Error}" Foreground="#F0AA91" FontSize="12" Style="{StaticResource OptionalNotice}"/>
  </Grid>
</UserControl>
