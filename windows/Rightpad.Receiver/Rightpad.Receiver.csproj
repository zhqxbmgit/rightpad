<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Rightpad.Receiver.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF uses the PerMonitorV2 manifest; the WinForms tray does not own DPI setup. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <Target Name="BuildVirtualHidBridge" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' And '$(RightpadReuseNative)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\BuildVirtualHid.ps1&quot; -Configuration $(Configuration) -ArtifactRoot &quot;$(RightpadArtifactsRoot)&quot; -Scope &quot;$(RightpadArtifactScope)&quot;" />
  </Target>
  <ItemGroup>
    <Content Include="$(RightpadNativeOutput)\Rightpad.VirtualHid.dll" Link="Rightpad.VirtualHid.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RightpadNativeOutput)\libvirtualhid-LICENSE.txt" Link="libvirtualhid-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RightpadNativeOutput)\lizardbyte-common-LICENSE.txt" Link="lizardbyte-common-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rightpad.Receiver.Tests" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
