<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RightpadSourceRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))" />
    <AssemblyMetadata Include="RightpadArtifactsRoot" Value="$(RightpadArtifactsRoot)" />
    <AssemblyMetadata Include="RightpadArtifactScope" Value="$(RightpadArtifactScope)" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <ProjectReference Include="../Rightpad.Receiver/Rightpad.Receiver.csproj" />
    <None Update="LauncherTests.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/k24-session-13653-px.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../tools/RightpadReceiverTask.ps1" Link="RightpadReceiverTask.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
